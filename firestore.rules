rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // さかなの うみ：ログインなしで、だれでも見られて、さかなを追加できる。
    // 書きかえ・けすことはできない（うみを からにするのは うつす画面の中だけ）。
    match /fish_seas/{room}/fish/{fishId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['img', 'shape', 'w', 'h', 't'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 900000
        && request.resource.data.img.matches('^data:image/(png|webp|jpeg);base64,.*')
        && request.resource.data.shape is string
        && request.resource.data.shape.size() < 20
        && request.resource.data.w is number
        && request.resource.data.h is number
        && request.resource.data.t is number;
    }

  }
}
